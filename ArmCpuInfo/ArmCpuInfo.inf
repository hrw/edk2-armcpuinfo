#        Or manually: python3 scripts/generate_handlers.py data/registers.yaml id_aa64_all_generated.c id_aa64.h
#
##

[Defines]
  INF_VERSION                    = 0x00010019
  BASE_NAME                      = ArmCpuInfo
  FILE_GUID                      = b3134491-6502-4faf-a9da-007184e32163
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  common.c
  id_aa64_all_generated.c
  ArmCpuInfo.c
  AArch64LibExtra.h
  AArch64Support.S

[Packages]
  ArmPkg/ArmPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  ArmLib
  UefiApplicationEntryPoint
  UefiLib

[BuildOptions]
  GCC:*_*_AARCH64_ASM_FLAGS = -march=armv8-a+sme
